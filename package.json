{
  "name": "nodespace",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "preview": "vite preview",
    "electron:dev": "concurrently --kill-others --success first \"vite --strictPort\" \"wait-on --timeout 20000 http://localhost:5174 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && npm run electron:package --",
    "electron:package": "electron-builder --publish never",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && node scripts/build-android.mjs",
    "release": "release.bat"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capawesome/capacitor-file-picker": "^8.0.2",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "d3": "^7.9.0",
    "katex": "^0.19.1",
    "pixi-filters": "^6.1.5",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.18.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.nodespace.app",
    "productName": "NodeSpace",
    "icon": "public/icon.svg",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
